        },
        {
          "offset": "84554F",
          "on": "E9F31AF400909090",
          "off": "C5FA108F902B0000"
        }
      ]
    },
    {
      "name": "--Enemy_Infinite_HP",
      "description": "",
      "type": "checkbox",
      "memory": [
        {
          "offset": "17870A0",
          "on": "01000000",
          "off": "00000000"
        }
      ]
    },
    {
      "name": "--One_Hit_Kill",
      "description": "Do NOT use One Hit Kill on the first bear(Bjorn).\r\nOtherwise you may not be able to complete the fight.\r\n\r\nAlso, OHK may cause an issue that certain enemies will not show up as they are programmed to be created when other enemies reach a certain HP level when they are getting hit, but OHK obviously just kills them instantly.\r\n\r\nIn such cases, if you are getting stuck, for example in the Old Friends quest, when reaching the cave with many Draugrs and can't pass the rocks-blocked door, \r\n\r\nI recommend you disable OHK, reload the checkpoint or reload a previous save and play that part again.",
      "type": "checkbox",
      "memory": [
        {
          "offset": "17870A4",
          "on": "01000000",
          "off": "00000000"
        }
      ]
    },
    {
      "name": "--Player_Infinite_HP",
      "description": "",
      "type": "checkbox",
      "memory": [
        {
          "offset": "178709C",
          "on": "01000000",
          "off": "00000000"
        }
      ]
    }
  ],
  "credits": [
    "Pharaoh2k"
  ]
